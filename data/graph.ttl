fx:concerns a owl:ObjectProperty ;
    rdfs:domain fx:QualityIssue ;
    rdfs:range fx:Part .

fx:defect a owl:DatatypeProperty ;
    rdfs:domain fx:QualityIssue ;
    rdfs:range xsd:string .

fx:hasComponent a owl:ObjectProperty,
        owl:TransitiveProperty ;
    rdfs:comment "BOM parent to child. Transitive: a product contains every part in its sub-assemblies." ;
    rdfs:domain fx:Item ;
    rdfs:range fx:Item .

fx:ofProduct a owl:ObjectProperty ;
    rdfs:domain fx:Installation ;
    rdfs:range fx:Product .

fx:ownedBy a owl:ObjectProperty ;
    rdfs:domain fx:Installation ;
    rdfs:range fx:Customer .

fx:sourceRecord a owl:DatatypeProperty ;
    rdfs:comment "Provenance: which source-system record was resolved to this entity, and how." .

fx:status a owl:DatatypeProperty ;
    rdfs:domain fx:QualityIssue ;
    rdfs:range xsd:string .

fx:suppliedBy a owl:ObjectProperty ;
    rdfs:domain fx:Part ;
    rdfs:range fx:Supplier .

